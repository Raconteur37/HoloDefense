[sub_resource type="Shader" id="Shader_nw1a1"]
code = "// fabricator_2d.gdshader
// Subnautica-style fabrication shader for Godot 4 — CanvasItem (2D)
// Works on: TextureRect, Sprite2D, NinePatchRect, or any node using a CanvasItem material.
//
// SETUP:
//   1. Select your TextureRect / Sprite2D
//   2. Material → New ShaderMaterial → Shader → Load this file
//   3. Animate \"progress\" from 0.0 to 1.0
//
// UNIFORMS:
//   progress         : 0.0 = invisible, 1.0 = fully assembled
//   tile_count       : cell density (higher = finer, more \"digital\")
//   edge_glow_color  : color of the assembly frontier glow
//   edge_glow_width  : width of the soft transition band per cell
//   noise_seed       : change to get a different assembly order
//   scan_speed       : speed of the horizontal scan sweep (set 0 to disable)
//   scan_color       : color of the scan band
//   base_emissive    : brightness of the fresh-assembly glow

shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.5;
uniform int   tile_count : hint_range(4, 64) = 18;
uniform vec4  edge_glow_color : source_color = vec4(0.0, 0.85, 1.0, 1.0);
uniform float edge_glow_width : hint_range(0.005, 0.3) = 0.08;
uniform float noise_seed = 1.337;
uniform float scan_speed = 0.4;
uniform vec4  scan_color : source_color = vec4(0.1, 0.6, 1.0, 1.0);
uniform float base_emissive : hint_range(0.0, 3.0) = 0.6;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

float hash21(vec2 p, float seed) {
    p += seed;
    p  = fract(p * vec2(127.1, 311.7));
    p += dot(p, p + 19.43);
    return fract(p.x * p.y);
}

// Voronoi: returns (dist_to_nearest, dist_to_2nd_nearest), writes cell ID
vec2 voronoi(vec2 uv, float cells, float seed, out vec2 out_id) {
    vec2 scaled = uv * cells;
    vec2 i      = floor(scaled);
    vec2 f      = fract(scaled);

    float d1 = 8.0, d2 = 8.0;
    vec2  best = vec2(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 nb   = vec2(float(x), float(y));
            vec2 cell = i + nb;
            vec2 jitter = vec2(
                hash21(cell, seed),
                hash21(cell, seed + 5.73)
            );
            vec2  diff = nb + jitter - f;
            float d    = dot(diff, diff);
            if (d < d1) { d2 = d1; d1 = d; best = cell; }
            else if (d < d2) { d2 = d; }
        }
    }
    out_id = best;
    return vec2(sqrt(d1), sqrt(d2));
}

float value_noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i,              42.0);
    float b = hash21(i + vec2(1,0),  42.0);
    float c = hash21(i + vec2(0,1),  42.0);
    float d = hash21(i + vec2(1,1),  42.0);
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// ---------------------------------------------------------------------------
// Fragment
// ---------------------------------------------------------------------------

void fragment() {
    vec2 uv = UV;

    // At full progress just output the raw texture — no effects whatsoever.
    if (progress >= 1.0) {
        COLOR = texture(TEXTURE, uv);
    }

    // Voronoi cell for this pixel
    vec2 cell_id;
    vec2 voro = voronoi(uv, float(tile_count), noise_seed, cell_id);

    // Random birth threshold per cell [0..1]
    float cell_rand = hash21(cell_id, noise_seed + 99.1);
    float threshold = cell_rand;

    // Sub-divide each cell into two triangles via local diagonal
    vec2  local    = fract(uv * float(tile_count));
    float tri_side = step(local.x + local.y, 1.0);
    float tri_ofs  = tri_side * 0.04;

    // \"Age\" of this triangle: <0 = unborn, 0..1 = assembling, >1 = done
    float age = (progress - (threshold + tri_ofs)) / max(edge_glow_width, 0.001);

    // Pixel visibility: smooth solidification
    float pixel_alpha = smoothstep(0.0, 1.0, clamp(age, 0.0, 1.0));

    // --- Scan line (sweeps top→bottom with progress) ---
    float scan_y   = progress + TIME * scan_speed * 0.01;
    float scan_d   = abs(uv.y - scan_y);
    float scan_band = smoothstep(0.035, 0.0, scan_d)
                    * smoothstep(1.0, 0.85, progress);

    // --- Edge glow at the assembly frontier ---
    float edge_dist = voro.y - voro.x;          // larger near cell boundaries
    float on_edge   = 1.0 - smoothstep(0.0, 0.1, edge_dist); // 1 = border, 0 = center
    float frontier  = smoothstep(edge_glow_width * 2.0, 0.0, abs(progress - threshold));
    float glow_mask = on_edge * frontier;

    // --- Sparkle particles during assembly ---
    float sparkle = 0.0;
    if (age > -0.5 && age < 1.5) {
        float sp = value_noise(uv * 80.0 + TIME * 2.0);
        sparkle  = step(0.97, sp) * (1.0 - pixel_alpha) * frontier * 3.0;
    }

    // --- Sample the node's own texture ---
    vec4 tex = texture(TEXTURE, uv);

    // Fade ALL effects to zero in the last 5% so progress=1 is a pure texture.
    // effect_fade: 1.0 at progress=0.95, smoothly 0.0 at progress=1.0
    float effect_fade = smoothstep(1.0, 0.95, progress);

    // Holographic tint on unassembled pixels
    float tint_t    = clamp(1.0 - pixel_alpha, 0.0, 1.0) * effect_fade;
    vec3  holo      = mix(tex.rgb, edge_glow_color.rgb * 1.4, tint_t * 0.65);
    float grain     = (value_noise(uv * 40.0 + TIME) - 0.5) * 0.12 * tint_t;
    vec3  final_rgb = clamp(holo + grain, 0.0, 1.0);

    // Additive glow layers
    float fresh = smoothstep(0.0, 1.0, age) * smoothstep(3.0, 0.8, age) * effect_fade;

    vec3 glow  = edge_glow_color.rgb * (glow_mask * base_emissive * 2.5) * effect_fade;
    glow      += scan_color.rgb      * scan_band  * 1.5;
    glow      += vec3(1.0, 0.95, 0.8) * sparkle   * effect_fade;
    glow      += edge_glow_color.rgb * fresh       * base_emissive;

    final_rgb = clamp(final_rgb + glow, 0.0, 1.5);

    // As effects fade, force all pixels fully opaque so no cells remain transparent.
    float final_alpha = mix(pixel_alpha, 1.0, 1.0 - effect_fade) * tex.a;

    COLOR = vec4(final_rgb, final_alpha);
}
"

