[gd_resource type="CanvasItemMaterial" load_steps=2 format=3 uid="uid://4bpt3aksgx0w"]

[sub_resource type="GDScript" id="GDScript_3ph8c"]
script/source = "shader_type canvas_item;

uniform float scrolling_speed = 6.0;

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	vec2 moving_uv = vec2(UV.x-(TIME*scrolling_speed),UV.y);
	vec4 in_tex = texture(TEXTURE,moving_uv);
	COLOR = in_tex;
}

//void light() {
	// Called for every pixel for every light affecting the CanvasItem.
	// Uncomment to replace the default light processing function with this one.
//}
"

[resource]
blend_mode = 1
script = SubResource("GDScript_3ph8c")
