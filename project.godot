[layer_names]

2d_physics/layer_1="Turrets"
2d_physics/layer_2="Projectiles"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Enemy Projectiles"
2d_physics/layer_5="Holo Citizen"
2d_physics/layer_6="Holo City Building"
2d_physics/layer_7="Minion"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.092397, 0.0923971, 0.092397, 1)
2d/snap/snap_2d_transforms_to_pixel=true
