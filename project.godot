; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Turret Defender"
run/main_scene="res://Game Scenes/Game.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameManager="*res://Globals/Scripts/game_manager.gd"
PlacementManager="*res://Globals/Scripts/placement_manager.gd"
ParticleManager="*res://Globals/Scripts/particle_manager.gd"
PopupScene="*res://Globals/Scene/Popup.tscn"
BeaconManager="*res://Globals/Scripts/beaconManager.gd"
SoundManager="*res://Globals/Scene/SoundManager.tscn"
EffectManager="*res://Globals/Scene/Effects.tscn"
EntityManager="*res://Globals/Scripts/entity_manager.gd"
StatisticPopup="*res://Globals/Scene/Statistic Popup.tscn"
CityManager="*res://Globals/Scripts/city_manager.gd"
DeveloperMode="*res://Globals/Scripts/developerMode.gd"
TurretManager="*res://Globals/Scripts/turretManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3

[global_group]

Turret=""
"Turret Projectile"=""
Enemy=""
"Enemy Projectile"=""
Energizer=""
Minion=""
Effect=""
"Turret Beam"=""
Explosion=""
Citizen=""
"Holo City Building"=""

[gui]

theme/default_font_multichannel_signed_distance_field=true

